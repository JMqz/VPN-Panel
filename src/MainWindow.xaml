<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Panel" Width="380" Height="660" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Font}" FontSize="13" UseLayoutRounding="True" AllowDrop="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Grid.Row="0" Margin="16,0,6,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="TitleIcon" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="VPN Panel" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="BtnMin" AutomationProperties.Name="Minimizar" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10" Width="34" Height="30" Padding="0" ToolTip="Minimizar"/>
        <Button x:Name="BtnClose" AutomationProperties.Name="Fechar" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="34" Height="30" Padding="0" ToolTip="Fechar (continua na bandeja)"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">

      <!-- ===== Início: first-run setup ===== -->
      <ScrollViewer x:Name="PageSetup" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="20,12,20,16">
          <Image x:Name="SetupMedallion" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Vamos deixar tudo pronto" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
          <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" FontSize="13" Margin="10,0"
                     Text="São só dois passos. Depois disso, conectar é um clique."/>

          <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Step1Badge" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface2}" VerticalAlignment="Top">
                <TextBlock x:Name="Step1Mark" Text="1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,3,0,0">
                <TextBlock Text="Instalar o WireSock" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="Programa gratuito que faz a conexão segura. O VPN Panel controla ele para você."/>
                <TextBlock x:Name="Step1Done" Text="Instalado" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="Step1Actions" Margin="0,10,0,0">
                  <StackPanel x:Name="Step1Working" Orientation="Horizontal">
                    <Ellipse x:Name="Step1Spinner" Width="18" Height="18" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeDashArray="8 200"
                             StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                      <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="Step1Status" Text="Instalando o WireSock..." FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="Step1Failed" Visibility="Collapsed">
                    <TextBlock x:Name="Step1Error" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button x:Name="BtnInstallWireSock" Style="{StaticResource PrimaryButton}" Content="Tentar de novo" Padding="14,7"/>
                      <Button x:Name="BtnGetWireSock" AutomationProperties.Name="Baixar no site do WireSock" Style="{StaticResource GhostButton}" Background="Transparent" Padding="10,7" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Baixar no site" VerticalAlignment="Center"/>
                          <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                             Text="É automático e leva menos de um minuto. Gratuito para uso pessoal."/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Step2Badge" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Surface2}" VerticalAlignment="Top">
                <TextBlock x:Name="Step2Mark" Text="2" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,3,0,0">
                <TextBlock Text="Adicionar um servidor" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="O servidor vem num arquivo que você baixa no site da sua VPN. No Proton VPN é grátis."/>
                <Border x:Name="Step2Found" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="TxtStep2Found" TextWrapping="Wrap"/>
                    <Button x:Name="BtnStep2Found" Style="{StaticResource PrimaryButton}" Content="Adicionar este" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <Button x:Name="BtnSetupProton" Style="{StaticResource PrimaryButton}" Content="Pegar no Proton VPN" Padding="14,8" Margin="0,10,0,0"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="BtnSetupHelp" Style="{StaticResource GhostButton}" Background="Transparent" Content="Outro provedor" Padding="10,7"/>
                  <Button x:Name="BtnSetupAdd" Style="{StaticResource GhostButton}" Background="Transparent" Content="Já tenho o arquivo" Padding="10,7"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Quando o arquivo chega na pasta Downloads, ele entra aqui sozinho. Também dá para arrastar ou colar (Ctrl+V)."/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Início ===== -->
      <Grid x:Name="PageHome" Margin="20,0,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Error banner -->
        <Border x:Name="ErrorBanner" Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource DangerSoft}"
                BorderBrush="#66E34039" Margin="0,4,0,0" Padding="14,12,6,12" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrIcon" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Danger}" Margin="0,1,10,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="TxtErrTitle" Text="Não foi possível conectar" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtErrDetail" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnRetry" Style="{StaticResource GhostButton}" Content="Tentar de novo" Padding="12,6"/>
                <Button x:Name="BtnErrLog" Style="{StaticResource GhostButton}" Background="Transparent" Content="Ver detalhes" Padding="10,6" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>
            <Button x:Name="BtnErrClose" Grid.Column="2" AutomationProperties.Name="Fechar aviso" Style="{StaticResource IconButton}"
                    Content="&#xE711;" FontSize="10" VerticalAlignment="Top" Margin="0,-6,0,0"/>
          </Grid>
        </Border>

        <!-- Central Power / Shield Symbol (Click to Connect / Disconnect) -->
        <Grid Grid.Row="1" Width="180" Height="180" Margin="0,18,0,0" HorizontalAlignment="Center">
          <!-- Soft radial glow behind the button -->
          <Ellipse x:Name="Glow" Width="210" Height="210" Margin="-15" IsHitTestVisible="False" Opacity="0">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#3044AD4D" Offset="0"/>
                <GradientStop Color="#1044AD4D" Offset="0.6"/>
                <GradientStop Color="#00101C2C" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <Button x:Name="BtnPower" AutomationProperties.Name="Conectar ou desconectar"
                  Style="{StaticResource PowerButton}" Width="160" Height="160" Cursor="Hand"
                  Background="Transparent" BorderThickness="0" Padding="0" ToolTip="Conectar">
            <Grid Width="160" Height="160">
              <!-- Outer Ring Track -->
              <Ellipse x:Name="StatusRing" Width="156" Height="156"
                       Stroke="{StaticResource Line}" StrokeThickness="3.5" Fill="{StaticResource Surface}"/>

              <!-- Spinning Spinner Ring for Connecting state -->
              <Ellipse x:Name="StatusSpinner" Width="156" Height="156"
                       Stroke="{StaticResource Warn}" StrokeThickness="3.5"
                       StrokeDashArray="30 15 8 15" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>

              <!-- Cyber Shield Canvas centered -->
              <Canvas Width="128" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                  <TranslateTransform X="0" Y="-2"/>
                </Canvas.RenderTransform>
                <!-- Shield Contour -->
                <Path x:Name="ShieldBg" Fill="{StaticResource Bg}" Stroke="{StaticResource Line}" StrokeThickness="2.2"
                      Data="M 64,10 C 98,10 112,19 114,30 C 114,80 90,108 64,122 C 38,108 14,80 14,30 C 16,19 30,10 64,10 Z"/>

                <!-- Raven Silhouette Inside Shield -->
                <!-- Tail Feathers (rendered under body so top edge is seamlessly covered) -->
                <Path x:Name="RavenTail" Fill="{StaticResource Muted}"
                      Data="M 53,92 C 50,105 49,114 55,116 C 60,120 67,120 72,116 C 77,114 76,105 73,92 Z"/>
                <!-- Beak -->
                <Path x:Name="RavenBeak" Fill="{StaticResource Muted}"
                      Data="M 72,40 C 81,40 88,43 92,48 C 92,48 84,49 78,49 C 72,48 72,40 72,40 Z"/>
                <!-- Head & Crest -->
                <Path x:Name="RavenHead" Fill="{StaticResource Muted}"
                      Data="M 50,54 C 52,40 60,35 69,37 C 74,38 75,44 72,47 C 72,47 71,52 73,55 C 75,58 66,60 58,60 C 50,60 50,54 50,54 Z"/>
                <!-- Body & Wings (curved base covers tail top seamlessly) -->
                <Path x:Name="RavenBody" Fill="{StaticResource Muted}"
                      Data="M 50,54 C 40,65 42,86 56,100 C 60,104 65,104 68,100 C 82,86 84,67 76,58 C 67,56 59,56 50,54 Z"/>
                <!-- Eye -->
                <Ellipse x:Name="RavenEye" Canvas.Left="68" Canvas.Top="41" Width="3" Height="3" Fill="{StaticResource Bg}"/>
              </Canvas>
            </Grid>
          </Button>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0">
          <TextBlock x:Name="TxtStatus" Text="Desconectado" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TxtScope" Text="Seu tráfego não está protegido" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12,4,12,0"/>
          <WrapPanel x:Name="HomeAppsPanel" HorizontalAlignment="Center" Margin="8,7,8,2" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtUptime" Text="" Foreground="{StaticResource Muted}" FontSize="12"
                     HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
          <!-- fixed widths: a new number re-measures only these TextBlocks, never the page -->
          <Grid x:Name="TrafficRow" HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed" Background="Transparent" ToolTip="">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112"/>
              <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
              <TextBlock x:Name="TxtDownIcon" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource SecureText}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtDown" Text="—" FontSize="12" FontWeight="SemiBold" Width="76" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
              <TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtUp" Text="—" FontSize="12" FontWeight="SemiBold" Width="76" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <Button x:Name="BtnServerCard" Grid.Row="4" AutomationProperties.Name="Trocar de servidor" Style="{StaticResource CardButton}" ToolTip="Trocar de servidor">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Surface2}">
              <Grid>
                <TextBlock x:Name="TxtFlag" Text="" FontWeight="Bold" FontSize="16" FontFamily="Segoe UI Emoji, Segoe UI"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFlagGlobe" Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="SERVIDOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSrvPing" Text="" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              </StackPanel>
              <TextBlock x:Name="TxtSrvName" Text="—" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              <TextBlock x:Name="TxtSrvDetail" Text="" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Trocar" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Button>

        <Border x:Name="IpCard" Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Seu IP" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <Button x:Name="BtnRefreshIp" AutomationProperties.Name="Verificar IP" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="11"
                      Padding="5" Margin="4,-4,0,-4" ToolTip="Verificar de novo"/>
            </StackPanel>
            <TextBlock x:Name="TxtIp" Grid.Column="1" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Localização" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
            <TextBlock x:Name="TxtLoc" Grid.Row="1" Grid.Column="1" Text="—" HorizontalAlignment="Right" Margin="16,9,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2" Text="Provedor" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
            <TextBlock x:Name="TxtOrg" Grid.Row="2" Grid.Column="1" Text="—" HorizontalAlignment="Right" Margin="16,9,0,0" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>

        <TextBlock x:Name="TxtIpNote" Grid.Row="6" Style="{StaticResource Caption}" Margin="4,8,4,0" Visibility="Collapsed"/>
      </Grid>

      <!-- ===== Servidores ===== -->
      <Grid x:Name="PageServers" Margin="20,0,20,12" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,8,0,0">
          <Button x:Name="BtnImport" AutomationProperties.Name="Adicionar servidor" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,7" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Adicionar" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnFastest" AutomationProperties.Name="Conectar ao mais rápido" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                  Padding="10,6" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Conectar ao servidor com menor ping">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="Mais rápido" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnPing" AutomationProperties.Name="Medir latência dos servidores" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                  Content="&#xE72C;" FontSize="12" Padding="8" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Medir a latência (ping) de novo"/>
          <StackPanel>
            <TextBlock Text="Servidores" Style="{StaticResource Title}"/>
            <TextBlock Text="Escolha por onde sua conexão vai passar" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>

        <!-- Search filter -->
        <Grid x:Name="ServerSearchBox" Grid.Row="1" Margin="0,10,0,0">
          <TextBox x:Name="TxtServerSearch" Style="{StaticResource Input}" Tag="Pesquisar servidor ou país..." Padding="10,6,28,6"/>
          <Button x:Name="BtnClearServerSearch" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Limpar busca" Visibility="Collapsed"/>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,12,-8,0" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ServerList"/>
        </ScrollViewer>

        <StackPanel x:Name="EmptyServers" Grid.Row="2" VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed">
          <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Nenhum servidor ainda" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
          <TextBlock Style="{StaticResource Caption}" TextAlignment="Center"
                     Text="Adicione o arquivo .conf do seu provedor de VPN. Dá para arrastar o arquivo para esta janela."/>
          <Button x:Name="BtnEmptyHelp" Style="{StaticResource GhostButton}" Content="Como conseguir o arquivo?" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>

        <Button x:Name="BtnServersHelp" Grid.Row="3" AutomationProperties.Name="Onde consigo mais servidores" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalAlignment="Center"
                Padding="10,6" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE897;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="Onde consigo mais servidores?" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- ===== Apps ===== -->
      <Grid x:Name="PageApps" Margin="20,0,20,16" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Quais apps usam a VPN" Style="{StaticResource Title}"/>
          <TextBlock x:Name="TxtAppsCfg" Text="" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
          <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
            <CheckBox x:Name="ChkSharedApps" AutomationProperties.Name="Usar em todos os servidores" Style="{StaticResource Switch}">
              <TextBlock Text="Usar em todos os servidores" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </CheckBox>
          </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="3" Margin="0,10,0,0">
          <UniformGrid Columns="3">
            <RadioButton x:Name="SegAll" Style="{StaticResource Segment}" GroupName="seg" Content="Todos"/>
            <RadioButton x:Name="SegOnly" Style="{StaticResource Segment}" GroupName="seg" Content="Só estes"/>
            <RadioButton x:Name="SegExcept" Style="{StaticResource Segment}" GroupName="seg" Content="Todos, exceto"/>
          </UniformGrid>
        </Border>
        <DockPanel Grid.Row="2" Margin="4,6,4,0">
          <Button x:Name="BtnVerifyApps" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="Transparent" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Ver com certeza quais programas abertos estão passando pela VPN">
            <TextBlock Text="Auditar agora" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
          </Button>
          <TextBlock x:Name="TxtModeHint" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel x:Name="AppsAdd" Grid.Row="3" Margin="0,10,0,0">
          <UniformGrid Columns="2">
            <Button x:Name="BtnRunningApps" AutomationProperties.Name="Escolher dos apps abertos" Style="{StaticResource GhostButton}" Margin="0,0,4,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="Apps abertos"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnBrowseExe" AutomationProperties.Name="Procurar programa" Style="{StaticResource GhostButton}" Margin="4,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="Procurar programa"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtAppName" Style="{StaticResource Input}" Tag="Ou digite o nome (ex.: chrome)"/>
            <Button x:Name="BtnAddApp" AutomationProperties.Name="Adicionar app" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,8" ToolTip="Adicionar">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="13"/>
            </Button>
          </Grid>
        </StackPanel>

        <Border x:Name="AppListCard" Grid.Row="4" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppList"/>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
          <TextBlock x:Name="TxtAppsSaved" Style="{StaticResource Caption}" TextAlignment="Center" Text="As mudanças são salvas automaticamente."/>
          <Border x:Name="ApplyBanner" Style="{StaticResource Card}" Background="{StaticResource WarnSoft}" BorderBrush="#66FFD524"
                  Padding="14,10,10,10" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="BtnApplyNow" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Reconectar" Padding="12,6"/>
              <TextBlock Text="Salvo. Reconecte para aplicar." VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ===== Opções ===== -->
      <ScrollViewer x:Name="PageOptions" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="20,8,20,16">
          <TextBlock Text="Opções" Style="{StaticResource Title}"/>

          <!-- Card de atualização disponível -->
          <Border x:Name="CardUpdate" Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Margin="0,14,0,0" Padding="14,12" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="BtnApplyUpdate" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Atualizar agora" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtUpdateFoundTitle" Text="Nova versão disponível" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock x:Name="TxtUpdateFoundDetail" Style="{StaticResource Caption}" Text="Versão pronta para instalar." Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Text="CONEXÃO" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,18,0,8"/>
          <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
              <CheckBox x:Name="ChkReconnect" AutomationProperties.Name="Reconectar se a conexão cair" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Reconectar se a conexão cair" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Tenta voltar sozinho até 3 vezes."/>
                </StackPanel>
              </CheckBox>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
              <CheckBox x:Name="ChkLock" AutomationProperties.Name="Bloquear a internet se a VPN cair" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Bloquear a internet se a VPN cair" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Nada sai sem proteção (kill switch). Protege apenas no modo &quot;Todos&quot;; em split-tunneling é desativado para não bloquear o DNS e a internet."/>
                  <TextBlock x:Name="TxtLockNote" Style="{StaticResource Caption}" Foreground="{StaticResource Warn}" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </CheckBox>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
              <CheckBox x:Name="ChkMtu" AutomationProperties.Name="Otimizar para chamadas, transmissões e jogos" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Otimizar para chamadas, transmissões e jogos" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Evita travamentos em telas compartilhadas e pacotes UDP grandes (MTU 1380). Vale na próxima conexão."/>
                </StackPanel>
              </CheckBox>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
              <CheckBox x:Name="ChkHotkey" AutomationProperties.Name="Atalho global Ctrl+Alt+V para conectar e desconectar" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Atalho global (Ctrl + Alt + V)" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Liga ou desliga a VPN de qualquer janela ou jogo."/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <TextBlock Text="PERSONALIZAÇÃO DE CORES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,18,0,8"/>
          <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Cor de destaque" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="Escolha a cor principal para a conexão, os botões e o ícone do corvo na bandeja."/>
              <WrapPanel x:Name="PanelColorPresets"/>
            </StackPanel>
          </Border>

          <TextBlock Text="AO LIGAR O PC" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,18,0,8"/>
          <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
              <CheckBox x:Name="ChkStartup" AutomationProperties.Name="Iniciar com o Windows" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Fica pronto na bandeja, perto do relógio."/>
                </StackPanel>
              </CheckBox>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
              <CheckBox x:Name="ChkAuto" AutomationProperties.Name="Conectar ao abrir" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Conectar ao abrir" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Liga a VPN assim que o app abre."/>
                </StackPanel>
              </CheckBox>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
              <CheckBox x:Name="ChkSkipUac" AutomationProperties.Name="Abrir sem pedir permissão" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Abrir sem pedir permissão" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="O Windows só pergunta na primeira vez que você abre o app."/>
                </StackPanel>
              </CheckBox>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>
              <CheckBox x:Name="ChkUpdates" AutomationProperties.Name="Verificar atualizações automaticamente" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Verificar atualizações automaticamente" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Avisa quando houver uma nova versão disponível."/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="6">
            <StackPanel>
              <Button x:Name="BtnCheckUpdate" AutomationProperties.Name="Verificar atualizações" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,9">
                <DockPanel>
                  <TextBlock x:Name="TxtUpdateBadge" DockPanel.Dock="Right" Text="" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock Text="Verificar se há atualizações" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button x:Name="BtnBackup" AutomationProperties.Name="Fazer backup dos servidores" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,9">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE72D;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock Text="Fazer backup dos servidores (.zip)" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button x:Name="BtnLog" AutomationProperties.Name="Ver log da conexão" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,9">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock Text="Ver log da conexão" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button x:Name="BtnDataDir" AutomationProperties.Name="Abrir pasta de dados" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,9">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock Text="Abrir pasta de dados" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button x:Name="BtnResetLock" AutomationProperties.Name="Liberar internet (reset do bloqueio)" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,9" ToolTip="Desativa o bloqueio de rede do WireSock e restaura o acesso à internet">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock Text="Liberar internet (reset do bloqueio)" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button x:Name="BtnQuit" AutomationProperties.Name="Sair do VPN Panel" Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,9">
                <DockPanel>
                  <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock Text="Sair do VPN Panel" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock x:Name="TxtAbout" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Testes & Saúde ===== -->
      <ScrollViewer x:Name="PageDiag" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="20,4,20,16">
          <TextBlock Text="Testes &amp; Saúde" Style="{StaticResource Title}"/>
          <Border x:Name="DiagRouteBadge" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Left">
            <TextBlock x:Name="TxtDiagRouteBadge" Text="Medindo conexão direta" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </Border>

          <!-- Cartão Veredito -->
          <Border x:Name="CardDiagVerdict" Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DiagVerdictDot" Width="10" Height="10" Fill="{StaticResource Muted}"
                       VerticalAlignment="Top" Margin="0,5,10,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="TxtDiagVerdict" Text="PRONTO PARA TESTAR" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtDiagVerdictSub" Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="Clique em Testar agora para verificar internet e VPN."/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Ações Principais -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnDiagQuick" Grid.Column="0" AutomationProperties.Name="Testar agora"
                    Style="{StaticResource PrimaryButton}" Content="Testar agora" Padding="10,8"/>
            <Button x:Name="BtnDiagContinuous" Grid.Column="2" AutomationProperties.Name="Teste contínuo"
                    Style="{StaticResource GhostButton}" Content="Teste contínuo" Padding="10,8"/>
          </Grid>

          <Button x:Name="BtnDiagRepair" AutomationProperties.Name="Reparar internet agora"
                  Style="{StaticResource DangerButton}" Content="Reparar internet agora"
                  Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed"/>

          <Button x:Name="BtnDiagCopy" AutomationProperties.Name="Copiar resultado"
                  Style="{StaticResource GhostButton}" Content="Copiar resultado"
                  Padding="12,7" Margin="0,8,0,0"/>

          <!-- Painel ao Vivo do Teste Contínuo -->
          <Border x:Name="CardDiagLive" Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="TxtDiagLiveTime" DockPanel.Dock="Right" Text="00:00"
                           FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDiagLiveStatus" Text="Aguardando início"
                           FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="ENVIADOS / PERDA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="TxtDiagSentLoss" Text="—" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                  <TextBlock Text="PING MÉD / MÁX" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="TxtDiagPing" Text="—" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="JITTER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="TxtDiagJitter" Text="—" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Text="QUEDAS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="TxtDiagDrops" Text="—" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Checklist de 5 Verificações -->
          <TextBlock Text="VERIFICAÇÕES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,14,0,8"/>
          <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ChkItem1Dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Internet Base" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock x:Name="TxtChk1Detail" Style="{StaticResource Caption}" Text="Aguardando verificação" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ChkItem2Dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="DNS do Windows" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock x:Name="TxtChk2Detail" Style="{StaticResource Caption}" Text="Aguardando verificação" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ChkItem3Dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Túnel &amp; Servidor VPN" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock x:Name="TxtChk3Detail" Style="{StaticResource Caption}" Text="Aguardando verificação" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ChkItem4Dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Kill Switch &amp; IPv6" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock x:Name="TxtChk4Detail" Style="{StaticResource Caption}" Text="Aguardando verificação" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,10"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ChkItem5Dot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Configuração &amp; Apps" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock x:Name="TxtChk5Detail" Style="{StaticResource Caption}" Text="Aguardando verificação" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnDiagApps" Grid.Column="2" AutomationProperties.Name="Ver apps"
                        Style="{StaticResource GhostButton}" Content="Ver apps" FontSize="11.5"
                        Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Bottom navigation -->
    <Border Grid.Row="2" Background="{StaticResource NavBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="5" Margin="8,0">
        <RadioButton x:Name="TabHome" Style="{StaticResource Tab}" GroupName="tabs" Tag="&#xE80F;" Content="Início" IsChecked="True"/>
        <RadioButton x:Name="TabServers" Style="{StaticResource Tab}" GroupName="tabs" Tag="&#xE774;" Content="Servidores"/>
        <RadioButton x:Name="TabApps" Style="{StaticResource Tab}" GroupName="tabs" Tag="&#xE71D;" Content="Apps"/>
        <RadioButton x:Name="TabDiag" Style="{StaticResource Tab}" GroupName="tabs" AutomationProperties.Name="Testes" Tag="&#xE9D9;" Content="Testes"/>
        <RadioButton x:Name="TabOptions" Style="{StaticResource Tab}" GroupName="tabs" Tag="&#xE713;" Content="Opções"/>
      </UniformGrid>
    </Border>
  </Grid>
</Window>
